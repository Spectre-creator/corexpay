# Copie para .env.local e preencha com as credenciais do seu projeto Supabase.
# Sem estas variáveis, o app roda com dados mock (src/lib/mock-data.ts).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opcional — usado apenas em scripts server-side / migração para Railway.
# NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Bot do Telegram (usado no fluxo de auth via initData quando o backend próprio existir).
TELEGRAM_BOT_TOKEN=
